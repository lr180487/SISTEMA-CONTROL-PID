# =============================================================================
# S_C_PID — configuración de entorno
# Copiar este archivo como .env y ajustar los valores a la instalación.
# No guardar contraseñas, certificados privados ni secretos en Git.
# =============================================================================

# Servidor web FastAPI
SCADA_HOST=127.0.0.1
SCADA_PORT=8000
SCADA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Histórico SQLite. Las rutas relativas se resuelven desde la raíz del proyecto.
SCADA_DB_PATH=data/flotation_historian.db

# El backend inicia siempre en SIMULATION. Para operar por OPC UA,
# conectar explícitamente desde el dashboard/API. Snap7 aún no tiene
# adquisición cíclica DB100 implementada.

# Cliente OPC UA — Siemens S7-1200 CPU 1214C / servidor PLCSIM compatible
SCADA_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
SCADA_OPCUA_ACTIVE=true
SCADA_OPCUA_SECURITY_POLICY=None
SCADA_OPCUA_USERNAME=
SCADA_OPCUA_PASSWORD=
SCADA_OPCUA_NAMESPACE_INDEX=3
SCADA_OPCUA_POLL_MS=500
SCADA_OPCUA_TIMEOUT_S=4.0

# Seguridad de control:
# Debe permanecer false durante desarrollo, simulación y puesta en marcha inicial.
# No habilitar hasta implementar autenticación/autorización y validar interbloqueos.
SCADA_ENABLE_CONTROL_WRITES=false
